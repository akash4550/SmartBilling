# -----------------------------------------------------------------------------
# Smart Billing — Environment Variables
# Copy this file to `.env` and fill in your own values.
# -----------------------------------------------------------------------------

# PostgreSQL connection string (used by Prisma & the Next.js server)
# For Docker Compose, the service is named `db` — use the host "db":
DATABASE_URL="postgresql://smartbill:smartbill@localhost:5432/smart_billing?schema=public"

# PostgreSQL credentials (used by docker-compose.yml only)
POSTGRES_USER=smartbill
POSTGRES_PASSWORD=smartbill
POSTGRES_DB=smart_billing

# OpenAI API key (used by /api/parse-receipt for AI receipt scanning)
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# NextAuth JWT secret (generate with `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`)
AUTH_SECRET="replace-with-a-long-random-string"

# Resend (transactional email). Get one at https://resend.com/api-keys
RESEND_API_KEY="re_..."
FROM_EMAIL="SmartBill <billing@example.com>"

# Stripe payments (international cards/wallets). Secret key + webhook secret
# for checkout.session.completed.
# Webhook endpoint: https://YOUR_DOMAIN/api/webhooks/stripe (listen for:
#   checkout.session.completed, payment_intent.succeeded, checkout.session.expired)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Razorpay payments (India: UPI, cards, netbanking, wallets). Get keys at
# https://dashboard.razorpay.com/app/keys. The key_id is public (also set
# as NEXT_PUBLIC_RAZORPAY_KEY_ID if you need client-only access).
# Webhook endpoint: https://YOUR_DOMAIN/api/webhooks/razorpay (listen for:
#   payment.captured, order.paid; secret is set here)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."

# Site URL (used in email links + Stripe/Razorpay return URLs). Vercel
# sets VERCEL_URL automatically; for Docker/self-host use NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cron secret (for the recurring invoice generator endpoint). Set it to a
# long random string and pass as Authorization: Bearer <CRON_SECRET> header
# when calling /api/cron/generate-recurring from your scheduler (GitHub
# Actions, Vercel Cron, etc.). If unset, no auth is required (single-instance
# dev / trusted-network deployments only).
CRON_SECRET=""

# Seed admin credentials (optional; defaults below)
ADMIN_EMAIL="admin@smartbill.com"
ADMIN_PASSWORD="password123"

# -----------------------------------------------------------------------------
# Upstash Redis (distributed rate limiting for admin Server Actions)
#
# When both variables are set, the ledger admin actions use a Redis-backed
# sliding-window limiter (10 req / 60s per user) that works across
# multi-instance / Vercel serverless deployments. If either is missing or
# Upstash is unreachable, the limiter transparently falls back to an
# in-process Map so the app keeps working in local dev or during Redis
# outages. Create a database at https://console.upstash.com/redis and copy
# the REST credentials here.
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
