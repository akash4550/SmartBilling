// Prisma schema for Smart Billing Application
// Uses PostgreSQL as the database provider
//
// Multi-tenant: every Client, Invoice, and Settings row belongs to a User.
// All write queries are scoped by userId (from session), and uniqueness
// constraints are scoped per-user where appropriate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USER MODEL
// ============================================================
model User {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  passwordHash      String
  resetToken        String?    @unique
  resetTokenExpires DateTime?
  // Monotonic session version. Incremented on password change or "sign out
  // everywhere" to revoke all outstanding JWTs (stateless JWT cannot otherwise
  // be invalidated without a server-side check).
  sessionVersion    Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  settings           Settings?
  clients            Client[]
  invoices           Invoice[]
  expenses           Expense[]
  recurringProfiles  RecurringProfile[]
  activities         InvoiceActivity[]
  // Tail pointer of the hash-chained ledger for this user. The newest
  // LedgerEntry.rowHash must equal this; the ledger enforces it via the
  // posting helper (SELECT ... FOR UPDATE on user row before insert).
  lastLedgerEntryHash String?
  lastLedgerEntryId   String?
  ledgerEntries       LedgerEntry[]

  @@map("users")
}

// ============================================================
// SETTINGS MODEL
// ============================================================
// One row per user (userId is unique). Created lazily on first
// access via prisma.settings.upsert({ where: { userId }, ... }).
model Settings {
  id              Int      @id @default(autoincrement())
  userId          String   @unique
  companyName     String   @default("Your Business Name")
  companyEmail    String   @default("billing@example.com")
  companyAddress  String?
  companyPhone    String?
  defaultTaxRate  Decimal  @default(0) @db.Decimal(5, 2)
  // Label shown next to the tax amount (e.g. "GST", "VAT", "TAX", "IGST").
  // Up to 12 chars; defaults to "GST" for INR merchants, "TAX" otherwise.
  taxLabel        String   @default("GST")
  currency        String   @default("INR")
  // Optional company logo (base64 data URI, max ~1 MB after client resize).
  // Used on invoice PDFs and in email headers. Displayed at up to ~180px
  // wide / 60px tall. null/empty = no logo (falls back to initial badge).
  logoData        String?  @db.Text
  logoContentType String?
  // Accent/brand color (hex, e.g. "#2563eb"). Used for PDF accent bar,
  // invoice title, CTA buttons in emails, and totals highlight.
  brandColor      String   @default("#2563eb")
  // Default terms/notes pre-filled on every new invoice (e.g. payment
  // instructions, bank details, late-fee policy). Can be overridden per
  // invoice.
  defaultNotes    String?  @db.Text
  // Default due days (0 = due on receipt, N = due in N days). Pre-fills
  // due date when creating a new invoice.
  defaultDueDays  Int      @default(30)
  // Invoice number prefix (alphanumeric, e.g. "INV", "ACME", "BIL").
  // Generator produces: <PREFIX><sep>YYYYMMDD<sep>NNNN.
  invoicePrefix   String   @default("INV")
  // Separator between prefix, date, and sequence number. Default "-".
  invoiceSeparator String  @default("-")
  // Zero-padding of sequence number. Default 4 (→ 0001).
  invoicePad      Int      @default(4)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

// ============================================================
// CLIENT MODEL
// ============================================================
// Uniqueness of email is scoped to the owning user (two tenants
// can each have a client with the same email).
model Client {
  id        String    @id @default(cuid())
  userId    String
  name      String
  email     String
  address   String?
  phone     String?
  // Free-form internal notes about this client (e.g. preferred contact method,
  // billing preferences, account manager). Not shown to the client.
  notes     String?   @db.Text
  // Optional per-client payment term override (in days). When set, creating an
  // invoice for this client uses this value instead of the user's
  // defaultDueDays. null/undefined means fall back to user default.
  dueDays   Int?
  // Random, non-guessable token used as the key for the client portal URL
  // (/portal/<token>). Generated on creation; can be rotated from the admin UI.
  portalToken String @default(cuid()) @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  recurringProfiles RecurringProfile[]

  @@unique([userId, email], name: "client_email_per_user")
  @@index([userId])
  @@map("clients")
}

// ============================================================
// INVOICE MODEL
// ============================================================
// invoiceNumber is unique globally so the public /view/:id link
// never collides between tenants. userId is included for fast
// tenant-scoped queries, and we cascade deletes through the
// client relation as before.
model Invoice {
  id            String        @id @default(cuid())
  userId        String
  invoiceNumber String        @unique
  clientId      String
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @db.Date
  dueDate       DateTime      @db.Date
  subtotal      Decimal       @db.Decimal(12, 2)
  // Discount (applied pre-tax). discountType controls whether discountValue
  // is treated as a percentage (0..100) or a flat amount in the invoice
  // currency. Default NULL means no discount.
  discountType  DiscountType?
  discountValue Decimal?      @db.Decimal(12, 2)
  discountAmount Decimal      @default(0) @db.Decimal(12, 2) // computed absolute discount in currency
  taxRate       Decimal       @default(0) @db.Decimal(5, 2)
  // Label shown next to the tax line for this invoice (copied from settings
  // at create-time so changing settings later doesn't rewrite historical
  // invoices).
  taxLabel      String        @default("GST")
  totalAmount   Decimal       @db.Decimal(12, 2)
  notes         String?       @db.Text
  paidAt        DateTime?
  lastSentAt    DateTime?
  lastRemindedAt DateTime?
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId String?
  razorpayOrderId String?
  razorpayPaymentId String?
  razorpaySignature String?
  // Recurring profile that generated this invoice (set automatically when
  // created by the recurring generator; null for one-off invoices).
  recurringProfileId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items    InvoiceItem[]
  recurring RecurringProfile? @relation(fields: [recurringProfileId], references: [id], onDelete: SetNull)
  activities InvoiceActivity[]

  @@index([clientId])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([userId, paidAt])
  @@index([userId, dueDate])
  @@index([userId, issueDate])
  @@index([stripePaymentIntentId])
  @@index([razorpayOrderId])
  @@map("invoices")
}

// ============================================================
// INVOICE ITEM MODEL
// ============================================================
model InvoiceItem {
  id          String  @id @default(cuid())
  // Denormalized userId for RLS tenant isolation. Backfilled from Invoice
  // on migration and always written explicitly when creating items. RLS
  // policies cannot traverse the invoice FK in all Prisma query shapes, so
  // we duplicate the tenant id directly on the child row.
  userId      String
  invoiceId   String
  description String
  quantity    Int     @default(1)
  price       Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([userId])
  @@map("invoice_items")
}

// ============================================================
// RECURRING PROFILE MODEL
// ============================================================
// Template for auto-generated invoices. When `active` is true and
// `nextRunAt` <= now, the cron endpoint (/api/cron/generate-recurring)
// will issue a new Invoice using this profile's clientId, line items,
// taxRate, notes, and frequency, then advance `nextRunAt`.
model RecurringProfile {
  id           String          @id @default(cuid())
  userId       String
  clientId     String
  frequency    RecurrenceFrequency // WEEKLY, MONTHLY, YEARLY, CUSTOM_DAYS
  intervalDays Int?            // when frequency=CUSTOM_DAYS, interval in days
  // Default terms (issue date = today; due date = today + dueInDays).
  dueInDays    Int             @default(30)
  taxRate      Decimal         @default(0) @db.Decimal(5, 2)
  notes        String?         @db.Text
  // What to do after generation: DRAFT (just create) or AUTO_SEND (mark
  // PENDING + email the client with a Pay Now link).
  autoSend     Boolean         @default(true)
  active       Boolean         @default(true)
  // Anchor date used to compute the *next* issue date. Updated after each run.
  nextRunAt    DateTime
  endDate      DateTime?       // optional stop date
  lastRunAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items  RecurringItem[]
  invoices Invoice[]

  @@index([userId, active, nextRunAt])
  @@index([userId])
  @@map("recurring_profiles")
}

model RecurringItem {
  id          String  @id @default(cuid())
  userId      String
  profileId   String
  description String
  quantity    Int     @default(1)
  price       Decimal @db.Decimal(12, 2)

  profile RecurringProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([userId])
  @@map("recurring_items")
}

// ============================================================
// INVOICE ACTIVITY MODEL
// ============================================================
// Append-only audit log of notable events for an invoice. Rendered as the
// "Activity" timeline on invoice detail pages. Write-only — never updated
// or deleted; events are created by the server on send/remind/pay/view/etc.
model InvoiceActivity {
  id        String            @id @default(cuid())
  invoiceId String
  userId    String
  type      InvoiceActivityType
  message   String?           @db.Text
  // IP address of the actor (for client views this is the public IP; for
  // admin actions it's the admin's IP). Useful for audit/debug.
  ip        String?
  // Optional structured metadata (e.g., payment provider, amount, email).
  meta      Json?
  createdAt DateTime          @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
  @@index([userId])
  @@map("invoice_activities")
}

// ============================================================
// ENUMS
// ============================================================
enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  VOID
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM_DAYS
}

enum InvoiceActivityType {
  CREATED
  EDITED
  SENT
  REMINDED
  VIEWED
  PAID
  PAYMENT_FAILED
  MARKED_PAID
  PDF_DOWNLOADED
  DELETED
  RECURRING_GENERATED
  VOIDED
  EMAIL_DELIVERED
  EMAIL_BOUNCED
  EMAIL_COMPLAINED
  EMAIL_OPENED
}

enum DiscountType {
  PERCENT
  FIXED
}

// ============================================================
// EXPENSE MODEL
// ============================================================
// Track business expenses (software subscriptions, contractor
// payments, materials, etc.) for P&L reporting. Currency matches
// the user's settings.currency; optional category for grouping.
model Expense {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  category    String   @default("General") // e.g. Software, Travel, Materials, Marketing
  description String
  amount      Decimal  @db.Decimal(12, 2)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, category])
  @@map("expenses")
}

// Back-relation from User to Expense (add to User model below).

// ============================================================
// WEBHOOK INGESTION MODEL (ASYNC DECOUPLED QUEUE)
// ============================================================
// Staging table for webhook payloads. The thin edge handlers validate
// the signature and INSERT the raw payload here (response <50ms), then
// a decoupled cron worker (`/api/cron/process-webhooks`) claims rows
// with SELECT ... FOR UPDATE SKIP LOCKED, processes them, and marks
// them DONE or DLQ after 5 failed attempts with exponential backoff.
//
// Key properties:
//  - Append-only: ROWS ARE NEVER UPDATED IN PLACE except for status
//    transitions during worker processing (claim, done, retry, dlq).
//  - Idempotency: unique (provider, providerEventId) allows INSERTs to
//    no-op on duplicate Stripe/Razorpay/Resend event IDs.
//  - Raw body is retained for 90 days for audit (purge via cron TTL
//    sweep if needed).
enum WebhookIngestionStatus {
  // Inserted by edge handler; awaiting worker pickup.
  PENDING
  // Claimed by a worker (locked_at set, locked_by identifies the worker).
  PROCESSING
  // Successfully processed.
  DONE
  // Transiently failed and moved to DLQ for later redrive. Rows may be
  // re-driven (back to PENDING) by /api/cron/redrive-dlq or by an
  // operator endpoint up to MAX_REDRIVES times.
  DLQ
  // Permanently quarantined — a deterministic fatal error (malformed
  // payload, unknown provider, invalid signature). These are never
  // auto-redriven; they require operator inspection and are flagged
  // as poison-pill for alerting.
  POISON
}

model WebhookIngestion {
  id              String                  @id @default(cuid())
  // "stripe" | "razorpay" | "resend" — kept as plain String (not enum)
  // so adding providers doesn't require a migration for trivial adapters.
  provider        String
  // Provider-side event ID (Stripe event.id, Razorpay event.id, Resend id).
  // Used for idempotency — duplicate webhook retries from the provider
  // will hit the unique constraint and be silently dropped (202 Accepted).
  providerEventId String?
  // Event type string (e.g., "checkout.session.completed", "payment.captured").
  eventType       String
  // Raw request body (unparsed text). Kept for 90 days for forensic audit.
  rawBody         String                  @db.Text
  // Stripe/Razorpay/Resend signature header at ingest time (for replay/audit).
  signature       String?
  // Delivery attempt counter; incremented on each failed processing run.
  attempts        Int                     @default(0)
  // Last error message surfaced by the handler (truncated to 2KB).
  lastError       String?                 @db.Text
  // Next eligible processing time (now + backoff). Backoff formula:
  //   5s * 2^attempts + jitter(0..1000ms)
  // PENDING/RETRY rows with nextAttemptAt <= now are eligible for claim.
  nextAttemptAt   DateTime                @default(now())
  // Status lifecycle: PENDING → PROCESSING → DONE
  //                           ↳ retries → PENDING/RETRY → DLQ → (redrive → PENDING) → POISON.
  status          WebhookIngestionStatus  @default(PENDING)
  // Worker identifier (process pid + hostname) while PROCESSING, for
  // operator visibility / stuck-claim reaping.
  lockedBy        String?
  lockedAt        DateTime?
  processedAt     DateTime?
  createdAt       DateTime                @default(now())

  // --- Batch 6 DLQ enhancements ---
  // True if the failure was deterministic (malformed payload, unknown
  // provider, bad signature) — auto-redrive is unsafe; quarantine as
  // POISON after initial classification.
  poisonPill      Boolean                 @default(false)
  // Why this was flagged as a poison pill (deterministic-failure reason).
  poisonReason    String?                 @db.Text
  // Number of times the row has been sent back from DLQ → PENDING via
  // redrive. After MAX_REDRIVES (3), it is promoted to POISON to prevent
  // infinite cycling.
  redriveCount    Int                     @default(0)
  // Earliest time a DLQ row is eligible for automatic redrive. Gives
  // operators a cooldown window after a downstream outage before replays
  // start. null means "not yet scheduled for redrive" (operator review).
  redriveAfter    DateTime?
  // Last time an alert was emitted for this row (rate-limits alert spam).
  lastAlertedAt   DateTime?
  // When the row was resolved / acknowledged by an operator.
  resolvedAt      DateTime?
  // Free-text operator note on resolution.
  resolveNote     String?                 @db.Text

  @@unique([provider, providerEventId], name: "wh_ingest_provider_event_uniq")
  @@index([status, nextAttemptAt], name: "wh_ingest_claim_idx")
  @@index([createdAt], name: "wh_ingest_created_idx")
  @@index([status, redriveAfter], name: "wh_ingest_redrive_idx")
  @@index([poisonPill, status], name: "wh_ingest_poison_idx")
  @@map("webhook_ingestions")
}

// ============================================================
// IMMUTABLE DOUBLE-ENTRY FINANCIAL LEDGER
// ============================================================
// Every financial state change (invoice issued, payment received,
// expense recorded, invoice voided) is recorded as a balanced set of
// LedgerEntry rows: the sum of DEBIT amounts equals the sum of CREDIT
// amounts for every eventId, enforced both at the application layer
// (posting helpers) AND as a Postgres CONSTRAINT trigger (defense in
// depth).
//
// The ledger is append-only: rows are NEVER updated or deleted. A VOID
// is modeled as a reversing entry (mirror debits/credits of the
// original issuance, plus a payment reversal if needed). A new
// `lastLedgerEntryHash` tail pointer on `users` allows O(1) hash-chain
// append; each entry's entryHash = SHA-256(prevEntryHash + canonical
// serialization of this entry) so the chain is tamper-evident.
//
// The Invoice.status column becomes a READ PROJECTION over the ledger
// (paid iff an INVOICE_PAID entry exists for the invoiceId; void iff a
// VOID entry exists). We keep the column as a cached materialization
// for query performance but the ledger is the source of truth.

enum AccountType {
  // Money owed to you (asset). Dr when invoice issued, Cr when paid.
  ACCOUNTS_RECEIVABLE
  // Sales income. Cr when invoice issued, Dr on void.
  REVENUE
  // Contra-revenue for discounts (debit balance, reduces net revenue).
  // Explicitly tracked so revenue is gross and discount is separate
  // rather than being buried in the REVENUE credit.
  DISCOUNT_CONTRA
  // Sales tax collected on behalf of the government (liability).
  // Cr when invoice issued, Dr on void.
  TAX_PAYABLE
  // Cash/bank (asset). Dr when payment lands, Cr when expenses paid.
  CASH
  // Cost of doing business (expense). Dr when expense recorded.
  EXPENSES
}

enum EntrySide {
  DEBIT
  CREDIT
}

enum LedgerEventType {
  // Invoice issued (post-send or on PENDING create):
  //   Dr ACCOUNTS_RECEIVABLE     total
  //   Cr REVENUE                 netAmount (pre-tax)
  //   Cr TAX_PAYABLE             taxAmount
  INVOICE_ISSUED
  // Payment received against an invoice:
  //   Dr CASH                    amountReceived
  //   Cr ACCOUNTS_RECEIVABLE     amountReceived
  INVOICE_PAID
  // Invoice voided — reverses the INVOICE_ISSUED entry exactly:
  //   Dr REVENUE                 netAmount
  //   Dr TAX_PAYABLE             taxAmount
  //   Cr ACCOUNTS_RECEIVABLE     total
  // (If the invoice was paid, we also reverse the payment entry below.)
  INVOICE_VOIDED
  // Payment reversal (e.g. chargeback / refund) — mirrors INVOICE_PAID:
  //   Dr ACCOUNTS_RECEIVABLE     amount
  //   Cr CASH                    amount
  PAYMENT_REVERSED
  // Business expense recorded (cash basis):
  //   Dr EXPENSES                amount
  //   Cr CASH                    amount
  EXPENSE_RECORDED
}

model LedgerEntry {
  id          String         @id @default(cuid())
  // Per-user hash chain; entries for different tenants never mix.
  userId      String
  // All rows that make up one balanced transaction share the same eventId
  // (a CUID allocated by the posting helper).
  eventId     String
  eventType   LedgerEventType
  account     AccountType
  side        EntrySide
  // Amount in integer SUBUNITS (paise for INR). Always positive — DEBIT
  // vs CREDIT is determined by the `side` column. Signed arithmetic is
  // avoided to prevent accidental sign-flip bugs.
  amountPaise BigInt
  // Hash chain pointer. SHA-256 of (prevEntryHash || canonical entry bytes).
  // The very first entry for a user has prevEntryHash = GENESIS (a constant).
  prevEntryHash String
  entryHash     String
  entryIndex    Int // 1-based position in the user's ledger (strictly increasing)
  // Links back to the source entity for audit. Exactly one of invoiceId
  // or expenseId is set for most events (VOID events may reference invoice).
  invoiceId   String?
  expenseId   String?
  // Optional memo/currency metadata.
  currency    String         @default("INR")
  note        String?        @db.Text
  createdAt   DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, eventId])
  @@index([invoiceId])
  @@index([expenseId])
  @@unique([userId, entryIndex])
  @@unique([userId, entryHash])
  @@map("ledger_entries")
}
